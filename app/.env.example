# Example environment variables for the Interopchain web application.
# Copy this file to .env and fill in the required values.
# NEVER commit .env to source control.

ENVIROMENT=development

# Base URL of the NodeJS backend server REST API
REACT_APP_API_URL=http://localhost:3002

# API
API_PORT=3002
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=fhir

# AWS KMS
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Port for the development server (Create React App convention)
PORT=3001
