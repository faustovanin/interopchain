# Example environment variables for the Interopchain web application.
# Copy this file to .env and fill in the required values.
# NEVER commit .env to source control.

# Environment for the application. Possible values: "development" or "production". Default is "production"
ENVIRONMENT=production

# Base URL of the NodeJS backend server REST API
REACT_APP_API_URL=http://localhost:3002

# API port for the NodeJS backend server
API_PORT=3002

# JWT secret for signing and verifying JSON Web Tokens (JWTs). Replace with a long random secret
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL
# Define user and password
# In development, leave localhost as host
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=fhir

# AWS KMS
# Define AWS credentials for KMS
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary session token for AWS KMS. If using long-term credentials, leave it empty
AWS_SESSION_TOKEN=

# Port for the development server (Create React App convention)
PORT=3001

# Points to the DataSteward IPFS node url 
IPFS_API_URL=http://localhost:5001

# Logging level for the application. Possible values: "all" or "error". Default is "error"
LOG_LEVEL=error
