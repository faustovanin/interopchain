# Nome do nó IPFS
NODE_NAME=ipfs-node
# IP do nó
NODE_IP=192.0.0.0

# Portas para IPFS
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080
IPFS_SWARM_PORT=4001

# Defina aqui o peer do nó principal, por exemplo:
BOOTSTRAP_PEER=/ip4/SEU_HOST/tcp/4001/p2p/SEU_PEER_ID

# Aponta para mais de um peer:
IPFS_BOOTSTRAP_PEERS=/ip4/SEU_HOST/tcp/4001/p2p/SEU_PEER_ID,/ip4/SEU_HOST/tcp/4001/p2p/SEU_PEER_ID