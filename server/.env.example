# Example environment variables for the Interopchain server.
# Copy this file to .env and fill in the required values.
# NEVER commit .env to source control.

# Server port
PORT=3000

# Secret used to sign JSON Web Tokens (use a long, random string in production)
JWT_SECRET=change_me_to_a_long_random_secret

# Path to the Hyperledger Fabric identity wallet directory
FABRIC_WALLET_PATH=./wallet

# Path to the Hyperledger Fabric connection profile JSON
FABRIC_CONNECTION_PROFILE=./connection-profile.json

# Passphrase for encrypting wallet private keys at rest
WALLET_ENCRYPTION_KEY=change_me_to_a_secure_passphrase

# Default Fabric channel name
FABRIC_CHANNEL_NAME=interopchain

# Default chaincode name
FABRIC_CHAINCODE_NAME=fhir-chaincode
